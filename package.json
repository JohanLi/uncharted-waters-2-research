{
  "name": "uncharted-waters-2-research",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "save-editor": "tsx watch --clear-screen=false save-editor/server.ts",
    "test:save-editor": "node --import tsx --test save-editor/*.test.ts",
    "draw-world-map": "node --import tsx scripts/draw-world-map/index.ts",
    "draw-tilesets": "node --import tsx scripts/tilesets/index.ts",
    "draw-winds-current-anomalies": "node --import tsx scripts/winds-current-anomalies/index.ts",
    "extract-ports": "node --import tsx scripts/ports/index.ts",
    "extract-ships": "node --import tsx scripts/ships/index.ts",
    "extract-art": "node --import tsx scripts/art/index.ts",
    "extract-event-art": "node --import tsx scripts/art/event-art.ts",
    "extract-graph-art": "node --import tsx scripts/art/graph-art.ts",
    "extract-portraits-items-discoveries": "node --import tsx scripts/portraits-items-discoveries/index.ts",
    "extract-dueling": "node --import tsx scripts/dueling/index.ts",
    "extract-dialog": "node --import tsx dialog-system/scripts/index.ts",
    "query-dialog": "node --import tsx dialog-system/scripts/query.ts",
    "extract-all": "node --import tsx scripts/extract-all.ts",
    "format": "prettier --write \"scripts/**/*.ts\" \"dialog-system/scripts/**/*.ts\" \"save-editor/**/*.{ts,js,css,html,md}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"scripts/**/*.ts\" \"dialog-system/scripts/**/*.ts\" \"save-editor/**/*.{ts,js,css,html,md}\" \"*.{json,md}\"",
    "test": "node --import tsx --test scripts/*.test.ts scripts/**/*.test.ts dialog-system/scripts/**/*.test.ts save-editor/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "prettier": "^3.9.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
